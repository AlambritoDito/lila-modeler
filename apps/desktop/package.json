{
  "name": "@lila-modeler/desktop",
  "productName": "Lila Modeler",
  "private": true,
  "version": "1.0.0-beta.9",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --build && node scripts/copy-web.mjs",
    "start": "electron .",
    "dev": "LILA_DEV_URL=http://localhost:5174 electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "LILA_SMOKE=1 electron .",
    "pack:mac": "npm run build && electron-builder --mac --arm64 --dir",
    "dist:mac": "npm run build && electron-builder --mac --arm64 && node scripts/origen.mjs",
    "icons": "node ../../tools/generate-branding.mjs"
  },
  "dependencies": {
    "@lila-modeler/engine": "1.0.0-beta.9"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  }
}
