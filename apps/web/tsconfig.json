{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  // `src/exportar.test.ts` importa el parser del motor, que a su vez importa `bpmn-moddle`.
  // El paquete no publica tipos del constructor y la declaración ambiente que los suple vive
  // en `packages/engine`; sin traerla aquí, este proyecto la da por `any` implícito.
  "include": [
    "src",
    "vite.config.ts",
    "../../packages/engine/src/bpmn/bpmn-moddle.d.ts"
  ]
}
