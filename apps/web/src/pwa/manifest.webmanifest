{
  "id": "./",
  "name": "Lila Modeler",
  "short_name": "Lila",
  "description": "Model BPMN processes and simulate them, on your machine.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "theme_color": "#7028f0",
  "background_color": "#ffffff",
  "icons": [
    { "src": "branding/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "branding/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "branding/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/vnd.lila-modeler+zip": [".lila"] } }
  ]
}
