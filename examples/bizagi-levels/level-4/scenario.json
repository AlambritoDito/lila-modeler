{
  "$schema": "https://lila-modeler.org/schema/scenario/1.json",
  "version": 1,
  "name": "Bizagi nivel 4 - analisis de calendarios (3 enfermeras + turnos)",
  "description": "Reproduce https://help.bizagi.com/platform/en/level_4_example.htm sobre la configuracion de recursos del nivel 3 (3 enfermeras). SCENARIO_FORMAT.md v1 no permite que un mismo pool de recursos tenga capacidad distinta segun el calendario (Bizagi si lo permite); los 4 recursos cuya disponibilidad varia por turno (Call center agent, Basic ambulance, Quick attention vehicle, Receptionist) se modelan como 3 pools -- uno por turno, cada uno con su propio 'calendar' y su capacidad de esa franja -- y la tarea los selecciona con selection:'or' (encola en los 3, arranca con el que este abierto; como los calendarios no se solapan, en la practica solo uno esta disponible a la vez). Nurse y Ambulance no varian por turno (3 y 4 en las tres franjas) y se dejan como un solo pool sin calendario (24x7). Ver examples/bizagi-levels/level-4/README y expected.json.",
  "model": "model.bpmn",
  "run": {
    "start": "2026-01-05T00:00:00+00:00",
    "duration": 604800,
    "currency": "USD"
  },
  "calendars": {
    "morning": { "intervals": [ { "days": ["MON","TUE","WED","THU","FRI","SAT","SUN"], "from": "06:00", "to": "14:00" } ] },
    "day":     { "intervals": [ { "days": ["MON","TUE","WED","THU","FRI","SAT","SUN"], "from": "14:00", "to": "22:00" } ] },
    "night":   { "intervals": [
                   { "days": ["MON","TUE","WED","THU","FRI","SAT","SUN"], "from": "22:00", "to": "24:00" },
                   { "days": ["MON","TUE","WED","THU","FRI","SAT","SUN"], "from": "00:00", "to": "06:00" }
                 ] }
  },
  "resources": {
    "nurse":     { "name": "Nurse",     "type": "role",      "capacity": 3, "fixedCost": 5, "costPerHour": 0 },
    "ambulance": { "name": "Ambulance", "type": "equipment", "capacity": 4, "fixedCost": 30, "costPerHour": 0.4 },

    "callCenterAgent_morning": { "name": "Call center agent (morning)", "type": "role", "capacity": 2, "fixedCost": 3, "costPerHour": 0, "calendar": "morning" },
    "callCenterAgent_day":     { "name": "Call center agent (day)",     "type": "role", "capacity": 2, "fixedCost": 3, "costPerHour": 0, "calendar": "day" },
    "callCenterAgent_night":   { "name": "Call center agent (night)",   "type": "role", "capacity": 1, "fixedCost": 3, "costPerHour": 0, "calendar": "night" },

    "basicAmbulance_morning": { "name": "Basic ambulance (morning)", "type": "equipment", "capacity": 2, "fixedCost": 25, "costPerHour": 0.3, "calendar": "morning" },
    "basicAmbulance_day":     { "name": "Basic ambulance (day)",     "type": "equipment", "capacity": 1, "fixedCost": 25, "costPerHour": 0.3, "calendar": "day" },
    "basicAmbulance_night":   { "name": "Basic ambulance (night)",   "type": "equipment", "capacity": 2, "fixedCost": 25, "costPerHour": 0.3, "calendar": "night" },

    "quickAttentionVehicle_morning": { "name": "Quick attention vehicle (morning)", "type": "equipment", "capacity": 1, "fixedCost": 18, "costPerHour": 0.22, "calendar": "morning" },
    "quickAttentionVehicle_day":     { "name": "Quick attention vehicle (day)",     "type": "equipment", "capacity": 2, "fixedCost": 18, "costPerHour": 0.22, "calendar": "day" },
    "quickAttentionVehicle_night":   { "name": "Quick attention vehicle (night)",   "type": "equipment", "capacity": 1, "fixedCost": 18, "costPerHour": 0.22, "calendar": "night" },

    "receptionist_morning": { "name": "Receptionist (morning)", "type": "role", "capacity": 2, "fixedCost": 3, "costPerHour": 0, "calendar": "morning" },
    "receptionist_day":     { "name": "Receptionist (day)",     "type": "role", "capacity": 1, "fixedCost": 3, "costPerHour": 0, "calendar": "day" },
    "receptionist_night":   { "name": "Receptionist (night)",   "type": "role", "capacity": 1, "fixedCost": 3, "costPerHour": 0, "calendar": "night" }
  },
  "elements": {
    "StartEvent_Llegada": { "interTriggerTimer": { "type": "exponential", "mean": 300 } },
    "Task_Recibir": {
      "processingTime": { "type": "constant", "value": 240 }, "fixedCost": 2,
      "resources": [ { "ref": "callCenterAgent_morning" }, { "ref": "callCenterAgent_day" }, { "ref": "callCenterAgent_night" } ],
      "selection": "or"
    },
    "Task_Clasificar": { "processingTime": { "type": "constant", "value": 300 }, "fixedCost": 1,
                         "resources": [ { "ref": "nurse", "quantity": 1 } ] },
    "Task_Gestionar":  { "processingTime": { "type": "constant", "value": 660 }, "fixedCost": 1,
                         "resources": [ { "ref": "nurse", "quantity": 1 } ] },
    "Task_Recoger":    { "processingTime": { "type": "constant", "value": 1200 }, "fixedCost": 0,
                         "resources": [ { "ref": "ambulance", "quantity": 1 } ] },
    "Task_LlegarQAV": {
      "processingTime": { "type": "constant", "value": 420 }, "fixedCost": 0,
      "resources": [ { "ref": "basicAmbulance_morning" }, { "ref": "basicAmbulance_day" }, { "ref": "basicAmbulance_night" } ],
      "selection": "or"
    },
    "Task_LlegarBA": {
      "processingTime": { "type": "constant", "value": 600 }, "fixedCost": 0,
      "resources": [ { "ref": "quickAttentionVehicle_morning" }, { "ref": "quickAttentionVehicle_day" }, { "ref": "quickAttentionVehicle_night" } ],
      "selection": "or"
    },
    "Task_Autorizar": {
      "processingTime": { "type": "constant", "value": 240 }, "fixedCost": 1,
      "resources": [ { "ref": "receptionist_morning" }, { "ref": "receptionist_day" }, { "ref": "receptionist_night" } ],
      "selection": "or"
    }
  }
}
