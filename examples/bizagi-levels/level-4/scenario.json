{
  "$schema": "https://lila-modeler.org/schema/scenario/1.json",
  "version": 1,
  "name": "Bizagi level 4 - calendar analysis (3 nurses + shifts)",
  "description": "Reconstructs https://help.bizagi.com/platform/en/level_4_example.htm on the three-nurse configuration from level 3. Arrivals and probabilities match level 2. LILA-164 represents Call center agent, Basic ambulance, Quick attention vehicle and Receptionist as one pool per role with calendar-dependent capacity, matching the published Morning/Day/Night shift table. The former three-pool OR workaround introduced off-hours wait and split utilization and cost by shift; see docs/BIZAGI_PARITY.md D7. Nurse and Ambulance stay at capacities 3 and 4, 24x7. QAV/BA follow the cost-consistent assignment documented in level 3. Night 22:00-06:00 is split into two intervals under R13. See level-4/expected.json.",
  "model": "model.bpmn",
  "run": {
    "start": "2026-01-05T00:00:00+00:00",
    "currency": "USD"
  },
  "calendars": {
    "morning": { "intervals": [ { "days": ["MON","TUE","WED","THU","FRI","SAT","SUN"], "from": "06:00", "to": "14:00" } ] },
    "day":     { "intervals": [ { "days": ["MON","TUE","WED","THU","FRI","SAT","SUN"], "from": "14:00", "to": "22:00" } ] },
    "night":   { "intervals": [
                   { "days": ["MON","TUE","WED","THU","FRI","SAT","SUN"], "from": "22:00", "to": "24:00" },
                   { "days": ["MON","TUE","WED","THU","FRI","SAT","SUN"], "from": "00:00", "to": "06:00" }
                 ] }
  },
  "resources": {
    "nurse":     { "name": "Nurse",     "type": "role",      "capacity": 3, "fixedCost": 5, "costPerHour": 0 },
    "ambulance": { "name": "Ambulance", "type": "equipment", "capacity": 4, "fixedCost": 30, "costPerHour": 0.4 },

    "callCenterAgent": { "name": "Call center agent", "type": "role", "fixedCost": 3, "costPerHour": 0,
      "capacity": [ { "calendar": "morning", "capacity": 2 }, { "calendar": "day", "capacity": 2 }, { "calendar": "night", "capacity": 1 } ] },

    "basicAmbulance": { "name": "Basic ambulance", "type": "equipment", "fixedCost": 25, "costPerHour": 0.3,
      "capacity": [ { "calendar": "morning", "capacity": 2 }, { "calendar": "day", "capacity": 1 }, { "calendar": "night", "capacity": 2 } ] },

    "quickAttentionVehicle": { "name": "Quick attention vehicle", "type": "equipment", "fixedCost": 18, "costPerHour": 0.22,
      "capacity": [ { "calendar": "morning", "capacity": 1 }, { "calendar": "day", "capacity": 2 }, { "calendar": "night", "capacity": 1 } ] },

    "receptionist": { "name": "Receptionist", "type": "role", "fixedCost": 3, "costPerHour": 0,
      "capacity": [ { "calendar": "morning", "capacity": 2 }, { "calendar": "day", "capacity": 1 }, { "calendar": "night", "capacity": 1 } ] }
  },
  "elements": {
    "StartEvent_Llegada": { "interTriggerTimer": { "type": "constant", "value": 300 }, "triggerCount": 2017 },
    "Flow_Red":    { "probability": 0.5 },
    "Flow_Yellow": { "probability": 0.3 },
    "Flow_Green":  { "probability": 0.2 },
    "Task_Recibir":    { "processingTime": { "type": "constant", "value": 240 }, "fixedCost": 2,
                         "resources": [ { "ref": "callCenterAgent", "quantity": 1 } ] },
    "Task_Clasificar": { "processingTime": { "type": "constant", "value": 300 }, "fixedCost": 1,
                         "resources": [ { "ref": "nurse", "quantity": 1 } ] },
    "Task_Gestionar":  { "processingTime": { "type": "constant", "value": 660 }, "fixedCost": 1,
                         "resources": [ { "ref": "nurse", "quantity": 1 } ] },
    "Task_Recoger":    { "processingTime": { "type": "constant", "value": 1200 }, "fixedCost": 0,
                         "resources": [ { "ref": "ambulance", "quantity": 1 } ] },
    "Task_LlegarQAV":  { "processingTime": { "type": "constant", "value": 420 }, "fixedCost": 0,
                         "resources": [ { "ref": "quickAttentionVehicle", "quantity": 1 } ] },
    "Task_LlegarBA":   { "processingTime": { "type": "constant", "value": 600 }, "fixedCost": 0,
                         "resources": [ { "ref": "basicAmbulance", "quantity": 1 } ] },
    "Task_Autorizar":  { "processingTime": { "type": "constant", "value": 240 }, "fixedCost": 1,
                         "resources": [ { "ref": "receptionist", "quantity": 1 } ] }
  }
}
