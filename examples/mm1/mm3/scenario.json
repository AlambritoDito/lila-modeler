{
  "$schema": "https://lila-modeler.org/schema/scenario/1.json",
  "version": 1,
  "name": "M/M/3 rho=0.8",
  "description": "Oracle M/M/3: 3 servers, lambda=1/125 s^-1, mu=1/300 s^-1 per server, rho=0.8. See expected.json (Erlang C) and README.md.",
  "model": "model.bpmn",
  "run": {
    "start": "2026-09-07T00:00:00+00:00",
    "duration": 2592000,
    "warmup": 3600,
    "replications": 30,
    "seed": 42,
    "baseTimeUnit": "s"
  },
  "resources": {
    "servidor": { "name": "Server", "type": "equipment", "capacity": 3 }
  },
  "elements": {
    "StartEvent_Llegadas": { "interTriggerTimer": { "type": "exponential", "mean": 125 }, "triggerCount": 100000 },
    "Task_Servicio": { "processingTime": { "type": "exponential", "mean": 300 },
                       "resources": [ { "ref": "servidor", "quantity": 1 } ] }
  }
}
