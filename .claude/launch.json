{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@lila/web"
      ],
      "port": 5173
    },
    {
      "name": "pages-static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
