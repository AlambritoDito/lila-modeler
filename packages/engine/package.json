{
  "name": "@lila/engine",
  "version": "0.0.0",
  "description": "Discrete-event simulation engine for BPMN processes, inspired by the simulation workflow of Bizagi Modeler and validated against public examples",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./bpmn": "./dist/bpmn/index.js",
    "./bpmn/lila.moddle.json": "./dist/bpmn/lila.moddle.json",
    "./schema": "./dist/scenario.js",
    "./messages": "./dist/messages/index.js",
    "./cli-shared": "./dist/cli-shared.js",
    "./result-schema": "./dist/result.schema.js",
    "./csv": "./dist/csv.js",
    "./format": "./dist/format.js"
  },
  "files": [
    "dist",
    "bin",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc --build",
    "golden:update": "tsx test/golden/generate.ts"
  },
  "dependencies": {
    "bpmn-moddle": "^10.2.0",
    "zod": "^4.5.4"
  },
  "bin": {
    "lila": "./bin/lila.js"
  }
}
